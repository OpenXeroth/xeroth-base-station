[Unit]
Description=snareSAR GNSS Base Station — Health HTTP endpoint (Tailscale-only)
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service
# Never stop retrying. With a start limit (10 starts in 600 s), a service
# that fails at boot -- here because Tailscale has no address yet, or the
# receiver is not yet on USB -- gives up for good after 10 tries and an
# unattended station stays broken until someone logs in. XER2's health
# service was down from 10 to 14 November 2026 this way.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/xeroth/base_station/scripts/gnss_health.py
User=xeroth
Restart=on-failure
RestartSec=10
# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/xeroth/base_station
# gcloud writes to ~/.config/gcloud/ (logs + credentials.db-journal) even for
# read-only operations like `auth list`. ProtectHome=read-only blocks this;
# ReadWritePaths re-grants write on that subtree specifically, so the
# gcs_auth_active() probe in gnss_health.py succeeds. The leading "-" makes
# the path optional: a station uploading with a network key has no gcloud
# and no ~/.config/gcloud, and without the "-" systemd refuses to start
# the service (status=226/NAMESPACE).
ReadWritePaths=/var/run -/home/xeroth/.config/gcloud
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK needed for `ip -4 addr` to enumerate Tailscale IP
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
